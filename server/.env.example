# MongoDB connection (shared application database for all organizations)
MONGO_URI=mongodb://localhost:27017/smart-artisan

# JWT signing secret — use a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret

# Google OAuth (Web client) — same Client ID as VITE_GOOGLE_CLIENT_ID in client/.env
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Runtime
NODE_ENV=development
PORT=5000

# Optional: log password-reset tokens to the console (never enable in production)
PASSWORD_RESET_DEBUG=false
